generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  MED
  ADMIN
  SALES_REP
}

enum AccountStatus {
  ACTIVE
  PENDING_VERIFICATION
  REJECTED
  SUSPENDED
}

enum TrainingType {
  ONLINE
  HANDS_ON
}

enum TrainingBrand {
  MINT_LIFT_PDO_THREADS
  MINT_MICROCANNULA
  KLARDIE
  TARGETCOOL
  EZ_TCON
}

enum TrainingLevel {
  MINT_LIFT_GROUP_TRAINING
  SUPPLEMENTAL
  ADVANCED
  PACKAGE_BUNDLE_1
  PACKAGE_BUNDLE_2
  SPECIAL_OFFER
}

enum TrainingStatus {
  ACTIVE
  CANCELLED
  COMPLETED
}

enum EnrollmentType {
  ENROLLEE
  OBSERVER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

enum TrainingApplicationStatus {
  DRAFT
  SUBMITTED
}

enum EnrollmentAttendanceStatus {
  PENDING
  COMPLETED
  NO_SHOW
}

enum EnrollmentStatus {
  ACTIVE
  CANCELLED
  RESCHEDULED
}

enum TrainingRequestType {
  CANCELLATION
  RESCHEDULE
}

enum TrainingRequestStatus {
  PENDING
  PAYMENT_REQUIRED
  APPROVED
  DECLINED
  CANCELLED
}

enum CreditReservationStatus {
  RESERVED
  APPLIED
  RELEASED
}

enum CreditTransactionType {
  EARNED // Credit added — e.g. enrolled in a training
  RESTORED // Previously spent credit returned after an order refund
  SPENT // Credit deducted — e.g. store purchase
  EXPIRED
}

enum ProductStatus {
  ACTIVE
  HIDDEN
}

enum CommerceOrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum CommercePaymentStatus {
  PENDING
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

enum OrderVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum FulfillmentStatus {
  UNFULFILLED
  PARTIALLY_FULFILLED
  FULFILLED
}

enum DeliveryStatus {
  NOT_APPLICABLE
  LABEL_CREATED
  IN_TRANSIT
  DELIVERED
  RETURNED
}

enum ShippingMethod {
  GROUND
  FREE_GROUND
  SECOND_DAY_AIR
  NEXT_DAY_AIR
  FREE_NEXT_DAY_AIR
  UPS_WORLDWIDE_SAVER
  MANUAL
  OTHER
}

enum ShippingLabelStatus {
  PENDING
  CREATED
  PRINTED
  VOIDED
  FAILED
}

enum OrderRefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum AppointmentStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

model User {
  id                       String                  @id @default(uuid())
  fullName                 String
  email                    String                  @unique
  phoneNumber              String                  @unique
  password                 String
  role                     Role                    @default(USER)
  accountStatus            AccountStatus           @default(ACTIVE)
  hasSubmittedVerification Boolean                 @default(false)
  medicalLicenseNumber     String?
  idDocumentFrontPath      String?
  idDocumentBackPath       String?
  verificationNotes        String?
  verifiedAt               DateTime?
  verifiedBy               String?
  creditBalance            Int                     @default(0) // Running credit score balance
  profilePicturePath       String?
  country                  String?
  city                     String?
  stateProvince            String?
  zipCode                  String?
  address                  String?
  // Medical Director (MED role)
  medDirectorFullName      String?
  medDirectorTitle         String?
  medDirectorTitleOther    String?
  // Business Information (MED role)
  practiceName             String?
  practiceAddressLine1     String?
  practiceAddressLine2     String?
  practiceCountry          String?
  practiceCity             String?
  practiceState            String?
  practiceZipCode          String?
  practicePhone            String?
  isExistingCustomer       Boolean?
  // Agreements
  agreedToTerms            Boolean                 @default(false)
  subscribedToUpdates      Boolean                 @default(false)
  deletedAt                DateTime?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  otps                     Otp[]
  enrollments              Enrollment[]
  salesRepEnrollments      Enrollment[]            @relation("SalesRepEnrollments")
  creditTransactions       CreditTransaction[]
  chatMessages             ChatMessage[]
  appointments             Appointment[]           @relation("MedAppointments")
  salesRepAppointments     Appointment[]           @relation("SalesRepAppointments")
  baEntries                BeforeAndAfterEntry[]   @relation("UserBAEntries")
  contestEntries           ContestEntry[]          @relation("UserContestEntries")
  contestLikes             ContestLike[]           @relation("AdminContestLikes")
  contestWeekResults       ContestWeekResult[]     @relation("ContestWeekResolver")
  commerceOrders           Order[]                 @relation("CommerceCustomerOrders")
  verifiedCommerceOrders   Order[]                 @relation("CommerceOrderVerifier")
  commerceStatusUpdates    OrderStatusHistory[]    @relation("CommerceStatusUpdatedBy")
  commerceRefundRequests   OrderRefund[]           @relation("CommerceRefundRequester")
  shippingLabelRequests    ShippingLabel[]         @relation("ShippingLabelRequester")
  stockAdjustments         StockAuditLog[]         @relation("StockAdjustedBy")
  trainingApplications     TrainingApplication[]   @relation("TrainingApplicationUser")
  referredApplications     TrainingApplication[]   @relation("TrainingApplicationSalesRep")
  creditReservations       CreditReservation[]
  creditGrants             CreditGrant[]
  reviewedTrainingRequests TrainingChangeRequest[] @relation("TrainingRequestReviewer")
  pushTokens               PushToken[]
  pushBroadcasts           PushBroadcast[]         @relation("PushBroadcastSender")
  cart                     Cart?
  favorites                Favorite[]
  draftOrders              DraftOrder[]            @relation("DraftOrderCustomer")
  createdDraftOrders       DraftOrder[]            @relation("DraftOrderCreator")
}

model Otp {
  id        String   @id @default(uuid())
  code      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Training {
  id                      String                  @id @default(uuid())
  type                    TrainingType
  brand                   TrainingBrand
  level                   TrainingLevel
  learningFormats         Json // String[] — validated values: "DEMO" | "DIDACTIC" | "DISCUSSION"
  title                   String
  speaker                 String
  speakerIntro            String
  speakerImagePath        String?
  productsUsed            String?
  areasCovered            String
  description             String
  backgroundImagePath     String?
  location                String? // e.g. "Morristown, NJ"
  scheduledAt             DateTime? // When the training is scheduled
  endsAt                  DateTime? // Final session date/time; defaults to scheduledAt for single-day training
  price                   Int // USD — auto-populated from level at creation
  creditScore             Int // In-house currency earned on enrollment — auto-populated from level
  subOptions              Json? // nullable — only for MINT_LIFT_GROUP_TRAINING
  status                  TrainingStatus          @default(ACTIVE)
  maxEnrollees            Int                     @default(4)
  maxObservers            Int                     @default(2)
  observerPrice           Int                     @default(500) // USD
  cancelledAt             DateTime?
  cancelledBy             String? // admin userId
  createdBy               String // admin userId
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  enrollments             Enrollment[]
  folders                 TrainingFolder[]
  applications            TrainingApplication[]
  originalChangeRequests  TrainingChangeRequest[] @relation("OriginalTrainingRequests")
  requestedChangeRequests TrainingChangeRequest[] @relation("RequestedTrainingRequests")
}

model TrainingApplication {
  id                      String                    @id @default(uuid())
  userId                  String
  user                    User                      @relation("TrainingApplicationUser", fields: [userId], references: [id], onDelete: Cascade)
  trainingId              String
  training                Training                  @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  salesRepId              String?
  salesRep                User?                     @relation("TrainingApplicationSalesRep", fields: [salesRepId], references: [id], onDelete: SetNull)
  prequalificationAnswers Json?
  registrationDetails     Json?
  backgroundCheckAnswers  Json?
  termsVersion            String?
  termsAcceptedAt         DateTime?
  submittedAt             DateTime?
  status                  TrainingApplicationStatus @default(DRAFT)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  @@unique([userId, trainingId])
  @@index([trainingId, status])
  @@index([salesRepId])
}

model Enrollment {
  id                          String                     @id @default(uuid())
  userId                      String
  user                        User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainingId                  String
  training                    Training                   @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  type                        EnrollmentType             @default(ENROLLEE)
  salesRepId                  String?
  salesRep                    User?                      @relation("SalesRepEnrollments", fields: [salesRepId], references: [id], onDelete: SetNull)
  paymentStatus               PaymentStatus              @default(PENDING)
  stripePaymentIntentId       String?
  stripeRefundId              String?
  paidAmount                  Int? // USD dollars
  trainingPriceAmount         Int? // Undiscounted USD price captured at registration
  paidAt                      DateTime?
  refundedAt                  DateTime?
  reservationExpiresAt        DateTime?
  attendanceStatus            EnrollmentAttendanceStatus @default(PENDING)
  status                      EnrollmentStatus           @default(ACTIVE)
  creditAmount                Int                        @default(0)
  creditIssuedAt              DateTime?
  creditExpiresAt             DateTime?
  completedAt                 DateTime?
  completedBy                 String?
  rescheduleCount             Int                        @default(0)
  noShowFeeAmount             Int?
  noShowFeeStatus             PaymentStatus?
  noShowStripePaymentIntentId String?
  enrolledAt                  DateTime                   @default(now())
  paymentAttempts             EnrollmentPaymentAttempt[]
  changeRequests              TrainingChangeRequest[]
  creditGrant                 CreditGrant?

  @@unique([userId, trainingId])
}

model EnrollmentPaymentAttempt {
  id                    String        @id @default(uuid())
  enrollmentId          String
  enrollment            Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  stripePaymentIntentId String        @unique
  status                PaymentStatus @default(PENDING)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([enrollmentId, status])
}

model CreditTransaction {
  id          String                @id @default(uuid())
  userId      String
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        CreditTransactionType
  amount      Int // Always positive — type determines direction
  description String // Human-readable e.g. "Enrolled in Advanced PDO Thread Techniques"
  referenceId String? // Optional — trainingId, orderId, etc.
  createdAt   DateTime              @default(now())
}

model CreditGrant {
  id              String                        @id @default(uuid())
  userId          String
  user            User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollmentId    String?                       @unique
  enrollment      Enrollment?                   @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  sourceKey       String                        @unique
  amount          Int
  remainingAmount Int
  expiresAt       DateTime?
  expiredAt       DateTime?
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt
  allocations     CreditReservationAllocation[]

  @@index([userId, expiresAt])
  @@index([userId, remainingAmount])
}

model TrainingChangeRequest {
  id                     String                @id @default(uuid())
  enrollmentId           String
  enrollment             Enrollment            @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  originalTrainingId     String
  originalTraining       Training              @relation("OriginalTrainingRequests", fields: [originalTrainingId], references: [id], onDelete: Cascade)
  requestedTrainingId    String?
  requestedTraining      Training?             @relation("RequestedTrainingRequests", fields: [requestedTrainingId], references: [id], onDelete: SetNull)
  type                   TrainingRequestType
  status                 TrainingRequestStatus @default(PENDING)
  reason                 String
  emergencyDetails       String?
  supportingDocumentPath String?
  feeAmount              Int                   @default(0)
  feePaymentStatus       PaymentStatus?
  stripePaymentIntentId  String?               @unique
  stripeRefundId         String?
  refundAmount           Int?
  penaltyAmount          Int?
  emergencyWaived        Boolean               @default(false)
  adminNote              String?
  reviewedById           String?
  reviewedBy             User?                 @relation("TrainingRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt             DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([enrollmentId, status])
  @@index([originalTrainingId, status])
  @@index([requestedTrainingId])
}

model Product {
  id                   String           @id @default(uuid())
  sku                  String?          @unique
  name                 String
  slug                 String           @unique
  description          String
  category             String?
  vendor               String?
  priceCents           Int?
  compareAtPriceCents  Int?
  currency             String           @default("USD")
  stockQty             Int              @default(0)
  lowStockThreshold    Int              @default(5)
  status               ProductStatus    @default(HIDDEN)
  imageUrl             String?
  assetPath            String?
  shippingInfo         String?
  returnAndExchange    String?
  shelfLife            String?
  disclaimer           String?
  usedWith             String?
  fdaCleared           Boolean          @default(false)
  securePackaging      Boolean          @default(false)
  groundShippingOnly   Boolean          @default(false)
  weightLbs            Float?
  stripeProductId      String?
  stripeDefaultPriceId String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  variants             ProductVariant[]
  images               ProductImage[]
  orderItems           OrderItem[]
  stockAuditLogs       StockAuditLog[]
  favorites            Favorite[]
  creditEligible       Boolean          @default(false)

  @@index([status])
  @@index([vendor])
  @@index([category])
  @@index([createdAt])
}

model ProductVariant {
  id            String      @id @default(uuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  label         String
  sku           String?     @unique
  priceCents    Int?
  stockQty      Int?
  stripePriceId String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  orderItems    OrderItem[]

  @@index([productId])
}

enum DraftOrderStatus {
  OPEN
  INVOICE_SENT
  CANCELLED
}

// An order an admin or sales rep prepares for a medical professional. It holds no stock;
// sending it creates a pending Order plus a Stripe Checkout link, and stock is taken when
// that order is paid.
model DraftOrder {
  id                String           @id @default(uuid())
  draftNumber       String           @unique
  customerId        String
  customer          User             @relation("DraftOrderCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  createdById       String
  createdBy         User             @relation("DraftOrderCreator", fields: [createdById], references: [id], onDelete: Restrict)
  status            DraftOrderStatus @default(OPEN)
  shippingAddress1  String?
  shippingAddress2  String?
  shippingCity      String?
  shippingState     String?
  shippingZipCode   String?
  shippingCountry   String?
  shippingMethod    ShippingMethod   @default(GROUND)
  notes             String?
  subtotalCents     Int?
  shippingFeeCents  Int?
  totalAmountCents  Int?
  orderId           String?          @unique
  order             Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  checkoutUrl       String?
  checkoutExpiresAt DateTime?
  invoiceSentAt     DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  items             DraftOrderItem[]

  @@index([customerId])
  @@index([createdById])
  @@index([status])
  @@index([createdAt])
}

model DraftOrderItem {
  id           String     @id @default(uuid())
  draftOrderId String
  draftOrder   DraftOrder @relation(fields: [draftOrderId], references: [id], onDelete: Cascade)
  productId    String
  variantId    String?
  quantity     Int
  sortOrder    Int        @default(0)

  @@index([draftOrderId])
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String?
  assetPath String?
  altText   String?
  sortOrder Int     @default(0)

  @@index([productId])
}

model Order {
  id                        String                  @id @default(uuid())
  orderNumber               String                  @unique
  userId                    String?
  user                      User?                   @relation("CommerceCustomerOrders", fields: [userId], references: [id], onDelete: SetNull)
  customerName              String
  customerEmail             String
  customerPhone             String?
  shippingAddress1          String?
  shippingAddress2          String?
  shippingCity              String?
  shippingState             String?
  shippingZipCode           String?
  shippingCountry           String?
  subtotalCents             Int
  shippingFeeCents          Int                     @default(0)
  taxCents                  Int                     @default(0)
  totalAmountCents          Int
  creditAppliedCents        Int                     @default(0)
  creditRefundedCents       Int                     @default(0)
  cardAmountCents           Int?
  currency                  String                  @default("USD")
  status                    CommerceOrderStatus     @default(PENDING)
  paymentStatus             CommercePaymentStatus   @default(PENDING)
  verificationStatus        OrderVerificationStatus @default(PENDING)
  fulfillmentStatus         FulfillmentStatus       @default(UNFULFILLED)
  deliveryStatus            DeliveryStatus          @default(NOT_APPLICABLE)
  shippingMethod            ShippingMethod?
  trackingNumber            String?
  courierName               String?
  trackingUrl               String?
  notes                     String?
  cancellationReason        String?
  cancellationNote          String?
  cancellationRequested     Boolean                 @default(false)
  cancellationRequestedAt   DateTime?
  cancellationRequestReason String?
  stripePaymentIntentId     String?                 @unique
  stripeCheckoutId          String?
  paidAt                    DateTime?
  verifiedAt                DateTime?
  verifiedById              String?
  verifiedBy                User?                   @relation("CommerceOrderVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  cancelledAt               DateTime?
  refundedAt                DateTime?
  shippedAt                 DateTime?
  deliveredAt               DateTime?
  archivedAt                DateTime?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  items                     OrderItem[]
  statusHistory             OrderStatusHistory[]
  refunds                   OrderRefund[]
  shippingLabels            ShippingLabel[]
  creditReservation         CreditReservation?
  draftOrder                DraftOrder?

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([verificationStatus])
  @@index([createdAt])
  @@index([archivedAt])
  @@index([cancellationRequested])
}

model CreditReservation {
  id          String                        @id @default(uuid())
  userId      String
  user        User                          @relation(fields: [userId], references: [id], onDelete: Restrict)
  orderId     String                        @unique
  order       Order                         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount      Int
  status      CreditReservationStatus       @default(RESERVED)
  appliedAt   DateTime?
  releasedAt  DateTime?
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt
  allocations CreditReservationAllocation[]

  @@index([userId, status])
}

model CreditReservationAllocation {
  id             String            @id @default(uuid())
  reservationId  String
  reservation    CreditReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  grantId        String
  grant          CreditGrant       @relation(fields: [grantId], references: [id], onDelete: Restrict)
  amount         Int
  refundedAmount Int               @default(0)
  createdAt      DateTime          @default(now())

  @@unique([reservationId, grantId])
  @@index([grantId])
}

model OrderItem {
  id             String          @id @default(uuid())
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName    String
  variantLabel   String?
  sku            String?
  quantity       Int
  unitPriceCents Int
  lineTotalCents Int

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model OrderStatusHistory {
  id                 String                   @id @default(uuid())
  orderId            String
  order              Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status             CommerceOrderStatus?
  paymentStatus      CommercePaymentStatus?
  fulfillmentStatus  FulfillmentStatus?
  deliveryStatus     DeliveryStatus?
  verificationStatus OrderVerificationStatus?
  action             String?
  note               String?
  updatedById        String?
  updatedBy          User?                    @relation("CommerceStatusUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt          DateTime                 @default(now())

  @@index([orderId])
  @@index([updatedById])
  @@index([createdAt])
}

model OrderRefund {
  id                   String            @id @default(uuid())
  orderId              String
  order                Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amountCents          Int
  forfeitedCreditCents Int               @default(0)
  currency             String            @default("USD")
  reason               String?
  status               OrderRefundStatus @default(PENDING)
  stripeRefundId       String?
  requestedById        String?
  requestedBy          User?             @relation("CommerceRefundRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([orderId])
  @@index([requestedById])
}

model ShippingLabel {
  id             String              @id @default(uuid())
  activeKey      String?             @unique
  orderId        String
  order          Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status         ShippingLabelStatus @default(PENDING)
  shippingMethod ShippingMethod?
  carrier        String              @default("UPS")
  serviceCode    String?
  trackingNumber String?
  trackingUrl    String?
  labelUrl       String?
  labelFormat    String?
  shipmentId     String?
  rateId         String?
  costCents      Int?
  errorMessage   String?
  currency       String              @default("USD")
  requestedById  String?
  requestedBy    User?               @relation("ShippingLabelRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  printedAt      DateTime?
  voidedAt       DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([createdAt])
}

model StockAuditLog {
  id               String   @id @default(uuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId        String?
  previousStockQty Int
  newStockQty      Int
  delta            Int
  note             String?
  adjustedById     String?
  adjustedBy       User?    @relation("StockAdjustedBy", fields: [adjustedById], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())

  @@index([productId])
  @@index([adjustedById])
  @@index([createdAt])
}

model Appointment {
  id              String            @id @default(uuid())
  medUserId       String
  medUser         User              @relation("MedAppointments", fields: [medUserId], references: [id], onDelete: Cascade)
  salesRepId      String?
  salesRep        User?             @relation("SalesRepAppointments", fields: [salesRepId], references: [id], onDelete: SetNull)
  date            String // "YYYY-MM-DD" e.g. "2026-03-18"
  time            String // e.g. "10:00 AM"
  timeZone        String? // IANA zone; legacy rows use the documented Pacific fallback
  notes           String? // Optional context from MED user
  status          AppointmentStatus @default(PENDING)
  zoomLink        String? // Filled on approval from ZOOM_MEETING_LINK env var
  rejectionReason String? // Filled on rejection — also sent as email
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String?
  imageUrl  String?
  createdAt DateTime @default(now())
}

// ─── Training Documents ────────────────────────────────────────────────────────

model TrainingFolder {
  id         String             @id @default(uuid())
  trainingId String
  training   Training           @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  name       String
  parentId   String?
  parent     TrainingFolder?    @relation("FolderChildren", fields: [parentId], references: [id])
  children   TrainingFolder[]   @relation("FolderChildren")
  files      TrainingDocument[]
  createdAt  DateTime           @default(now())
}

model TrainingDocument {
  id        String         @id @default(uuid())
  folderId  String
  folder    TrainingFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  fileName  String
  filePath  String
  fileSize  Int
  mimeType  String
  createdAt DateTime       @default(now())
}

// ─── Before & After ───────────────────────────────────────────────────────────

model BeforeAndAfterEntry {
  id          String                @id @default(uuid())
  userId      String
  user        User                  @relation("UserBAEntries", fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String
  media       BeforeAndAfterMedia[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

model BeforeAndAfterMedia {
  id       String              @id @default(uuid())
  entryId  String
  entry    BeforeAndAfterEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  section  MediaSection // BEFORE or AFTER
  label    String // e.g. "Left Side Face", "Center Face", "Right Side Face"
  filePath String
}

enum MediaSection {
  BEFORE
  AFTER
}

enum ContestWeekStatus {
  WINNER
  TIE
  NO_WINNER
}

// ─── B&A Contest ──────────────────────────────────────────────────────────────

model ContestEntry {
  id          String              @id @default(uuid())
  userId      String
  user        User                @relation("UserContestEntries", fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String
  media       ContestEntryMedia[]
  likes       ContestLike[]
  weeklyWins  ContestWeekResult[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model ContestWeekResult {
  id            String            @id @default(uuid())
  weekKey       String            @unique
  status        ContestWeekStatus
  winningVotes  Int               @default(0)
  winnerEntryId String?
  winnerEntry   ContestEntry?     @relation(fields: [winnerEntryId], references: [id], onDelete: SetNull)
  resolvedById  String?
  resolvedBy    User?             @relation("ContestWeekResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([winnerEntryId])
  @@index([resolvedById])
}

model ContestEntryMedia {
  id       String       @id @default(uuid())
  entryId  String
  entry    ContestEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  section  MediaSection // BEFORE or AFTER
  filePath String
  fileType String       @default("image") // "image" or "video"
}

model ContestLike {
  id        String       @id @default(uuid())
  entryId   String
  entry     ContestEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  adminId   String
  admin     User         @relation("AdminContestLikes", fields: [adminId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([entryId, adminId])
}

// ─── Popup Ads ────────────────────────────────────────────────────────────────

model AdConfig {
  id              String    @id @default(uuid())
  isActive        Boolean   @default(true)
  intervalSeconds Int       @default(3)
  slides          AdSlide[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model AdSlide {
  id          String   @id @default(uuid())
  adConfigId  String
  adConfig    AdConfig @relation(fields: [adConfigId], references: [id], onDelete: Cascade)
  imageUrl    String
  redirectUrl String   @default("")
  createdAt   DateTime @default(now())

  @@index([adConfigId])
}

// ─── Discount Codes ───────────────────────────────────────────────────────────

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum DiscountApplicableTo {
  TRAINING
  PRODUCTS
  BOTH
}

model DiscountCode {
  id           String               @id @default(uuid())
  code         String               @unique
  type         DiscountType
  value        Float
  applicableTo DiscountApplicableTo @default(BOTH)
  maxUses      Int?
  usedCount    Int                  @default(0)
  expiresAt    DateTime?
  isActive     Boolean              @default(true)
  createdBy    String
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([code])
  @@index([isActive])
}

// ─── Push notifications ───────────────────────────────────────────────────────

/// One Expo push token per device; a device moves to whoever signs in on it.
model PushToken {
  id        String   @id @default(uuid())
  token     String   @unique
  platform  String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// An admin announcement and its delivery counts (ALL | MED | USER | SALES_REP).
model PushBroadcast {
  id             String   @id @default(uuid())
  title          String
  body           String
  audience       String
  recipientCount Int      @default(0)
  sentCount      Int      @default(0)
  failedCount    Int      @default(0)
  sentById       String?
  sentBy         User?    @relation("PushBroadcastSender", fields: [sentById], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

// ─── Carts and favorites ──────────────────────────────────────────────────────

/// Server mirror of a customer's on-device cart, used for abandoned-cart follow-up.
model Cart {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         Json
  itemCount     Int      @default(0)
  subtotalCents Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([updatedAt])
}

/// A product a customer hearted for quick access.
model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}
